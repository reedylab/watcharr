# Watcharr environment configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# qBittorrent connection
QB_URL=http://localhost:8080/
QB_USERNAME=admin
QB_PASSWORD=
QB_CONTAINER=qbittorrent

# Watchdog settings
CHECK_INTERVAL=60

# Optional: auto-remove torrents that stay stalled past STALL_TIMEOUT_MIN minutes.
# Disabled by default — Watcharr will only reannounce / pause-resume / restart.
STALL_REMOVAL_ENABLED=false
STALL_TIMEOUT_MIN=5

# Optional: dashboard authentication (disabled when empty)
# AUTH_USERNAME=admin
# AUTH_PASSWORD=changeme

# Python output (recommended for Docker)
PYTHONUNBUFFERED=1
